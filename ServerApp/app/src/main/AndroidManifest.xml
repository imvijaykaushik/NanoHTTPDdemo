<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to open a listening socket. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Used to read the device's own Wi-Fi IP so it can be shown in the UI. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      The HTTP server runs inside a foreground service so it keeps serving while
      the user is in the Client app, and is not killed under memory pressure.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
      Android 14 (API 34) requires a specific type to be declared alongside the
      generic permission above. DATA_SYNC covers a local network listener.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      Android 13 (API 33) made the foreground-service notification a runtime
      permission. The service still runs if it is denied, but silently, so the
      UI asks for it before starting.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".ServerApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.App">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Hosts the embedded HTTP server.

          stopWithTask="false" keeps it serving when the app is swiped away from
          Recents; the notification's Stop action (and the in-app Stop button)
          are the ways to shut it down.
        -->
        <service
            android:name=".data.service.HttpServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            android:stopWithTask="false" />
    </application>
</manifest>
